@unpublished{le2026robustfixedtimefaulttolerant,
  abbr              = {S1},
  title             = {Robust Fixed-time Fault Tolerant Control for Nonlinear Full-car Active Suspension System},
  author            = {Gia Khiem Dinh and Huu Viet Nguyen and Duc Chinh Hoang and Duc Thinh Le and Tung Lam Nguyen},
  journal           = {Nonlinear Dynamics},
  year              = {2026},
  note              = {Manuscript submitted for publication (submitted 22 April 2026).<br> <span class="author-role role-co">Co-author.</span>},
  abstract          = {This paper is an investment to develop a robust fixed-time fault-tolerant control for a seven DoF full-car active suspension system subjected to unknown nonlinearity, parameter uncertainties, and actuator faults. Although unknown dynamic and fault problems are well-known to usually exist in the dynamic model of the active suspension system on vehicles, solving for both issues simultaneously significantly increases the complexity of the control design. Moreover, the maximum suspension deflection constraint is discussed. To address this problem, a fixed-time disturbance observer is employed to accurately compensate for unknown dynamics and actuator faults in real-time. A nonlinear low-pass filter is proposed to generate the desired reference for the displacement of the vehicle body, which manages the tradeoffs between handling stability and riding comfort. By using a fixed-time control scheme to guarantee the tracking error convergence within a fixed time, the maximum suspension deflection constraint is ensured while successfully achieving ride comfort. The stability of the closed-loop system is demonstrated by the Lyapunov theory. Numerical simulation results are presented to verify the effectiveness and robustness of the proposed method.},
  preview           = {active-suspension.png},
  role              = {co}
}

@unpublished{le2026cascadefixedtime,
  abbr              = {S2},
  title             = {Cascade Fixed-Time Prescribed-Performance Control for High-Speed Autonomous Vehicle Trajectory Tracking with Actuator Faults and Input Delay},
  author            = {Tien Dung Nguyen and Duc Thinh Le and Duc Chinh Hoang and Tung Lam Nguyen},
  journal           = {Robotics and Autonomous Systems},
  year              = {2026},
  note              = {Manuscript submitted for publication (submitted 21 July 2026).<br> Tien Dung Nguyen and <strong class="cv-highlight">Duc Thinh Le</strong> contributed equally as <span class="author-role role-first">co-first authors</span>.},
  abstract          = {Existing trajectory tracking controllers for autonomous vehicles (AVs) typically treat the steering angle as an ideal, directly available input, overlooking the actuation errors introduced by the electric power steering (EPS) system under real-world faults and delays. This paper proposes a fixed-time prescribed-performance trajectory tracking control framework for autonomous vehicles operating at high speeds under strong crosswinds, actuator faults, and steering input delays. To capture the interaction between vehicle motion and steering actuation, an integrated dynamic model combining the lateral vehicle dynamics and the electric power steering system is considered. The proposed cascade framework consists of an inner loop for electric power steering regulation and an outer loop for lateral trajectory tracking. Fixed-time extended state observers are developed in both loops to estimate unmeasured velocities and lumped disturbances caused by model uncertainties, strong crosswinds, actuator faults, and input delays. To improve transient performance during high-speed operation, a prescribed performance function is incorporated into the outer loop to constrain tracking errors within predefined bounds. Fixed-time sliding-mode controllers are then designed to ensure that the closed-loop tracking errors converge within a settling time independent of the initial conditions. Theoretical analysis establishes the fixed-time stability and prescribed-performance properties of the closed-loop system. MATLAB/Simulink and CarSim co-simulations under high-speed driving, crosswind disturbances, EPS actuator faults, and input delays show that the proposed method reduces the integral-error tracking metrics (IAE, ISE, ITAE) by more than 25% across all scenarios compared with two existing backstepping-based controllers, with substantially larger gains observed under certain conditions, confirming its rapid response, accurate tracking, and strong robustness.},
  keywords          = {lead-author},
  preview           = {full-car-active-suspension.png},
  video             = {https://www.youtube.com/embed/mtORvVqtZiA},
  role              = {first}
}

